{
  "name": "coderoom",
  "version": "1.0.0",
  "private": true,
  "description": "CodeRoom — collaborative coding and isolated cloud execution platform.",
  "scripts": {
    "dev": "concurrently -n app,executor -c magenta,cyan \"tsx server/index.ts\" \"tsx executor/index.ts\"",
    "dev:app": "tsx server/index.ts",
    "dev:executor": "tsx executor/index.ts",
    "build": "prisma generate && next build",
    "start": "tsx server/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@prisma/client": "6.7.0",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "5.53.0",
    "cookie": "1.0.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "ioredis": "5.6.1",
    "lucide-react": "0.468.0",
    "monaco-editor": "0.55.1",
    "next": "^16.3.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.6",
    "yjs": "13.6.27",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie": "1.0.0",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.3",
    "@types/node": "22.10.7",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "concurrently": "9.1.2",
    "prisma": "6.7.0",
    "tsx": "4.19.3",
    "typescript": "5.7.2"
  }
}
